#!/bin/sh
set -eu

env_file=${QQNT_BRIDGE_ENV_FILE:-/etc/qqnt-bridge.env}
if [ ! -r "$env_file" ]; then
  echo "cannot read $env_file; run as root (for example: sudo qqntctl qr)" >&2
  exit 1
fi
. "$env_file"

base="http://${QQNT_BRIDGE_HOST:-127.0.0.1}:${QQNT_BRIDGE_PORT:-18767}"
auth="Authorization: Bearer ${QQNT_BRIDGE_TOKEN}"
systemctl_command=${QQNT_BRIDGE_SYSTEMCTL:-systemctl}
curl_command=${QQNT_BRIDGE_CURL:-curl}
qrencode_command=${QQNT_BRIDGE_QRENCODE:-qrencode}

wait_for_qr_url() {
  "$curl_command" -fsS -X POST -H "$auth" "$base/v1/login/qrcode/refresh" >/dev/null 2>&1 || true
  tries=0
  while [ "$tries" -lt 60 ]; do
    if url=$("$curl_command" -fsS -H "$auth" "$base/v1/login/qrcode/url" 2>/dev/null); then
      printf '%s\n' "$url"
      return 0
    fi
    tries=$((tries + 1))
    sleep 1
  done
  echo "QR code was not produced within 60 seconds" >&2
  return 1
}

case "${1:-status}" in
  status)
    "$curl_command" -fsS -H "$auth" "$base/v1/status"
    printf '\n'
    ;;
  qr)
    if [ "${2:-}" = "--png" ]; then
      output=${3:-qqnt-login.png}
      wait_for_qr_url >/dev/null
      "$curl_command" -fsS -H "$auth" "$base/v1/login/qrcode.png" -o "$output"
      echo "saved QR code to $output"
    else
      wait_for_qr_url | "$qrencode_command" -t ANSIUTF8
    fi
    ;;
  refresh)
    "$curl_command" -fsS -X POST -H "$auth" "$base/v1/login/qrcode/refresh"
    printf '\n'
    ;;
  logs)
    exec journalctl -u qqnt-bridge.service -f
    ;;
  restart)
    exec "$systemctl_command" restart qqnt-bridge.service
    ;;
  logout|switch-account)
    state_dir=${QQNT_BRIDGE_STATE_DIR:-/var/lib/qqnt-bridge}
    login_dir="$state_dir/.config/qqnt-bridge-injection/auth"
    backup_dir="$state_dir/backups/login"
    stamp=$(date +%Y%m%d-%H%M%S)-$$
    "$systemctl_command" stop qqnt-bridge.service
    mkdir -p "$backup_dir"
    chmod 0700 "$backup_dir"
    moved=0
    for name in login.enc login.enc-wal login.enc-shm login.enc-journal; do
      if [ -f "$login_dir/$name" ]; then
        mv -- "$login_dir/$name" "$backup_dir/$name.$stamp"
        chmod 0600 "$backup_dir/$name.$stamp"
        moved=1
      fi
    done
    lkg_archive="$state_dir/backups/session/last-known-good.tar.gz"
    if [ -f "$lkg_archive" ]; then
      mv -- "$lkg_archive" "$backup_dir/session.last-known-good.$stamp.tar.gz"
      chmod 0600 "$backup_dir/session.last-known-good.$stamp.tar.gz"
      moved=1
    fi
    "$systemctl_command" start qqnt-bridge.service
    if [ "$moved" -eq 1 ]; then
      echo "QQNT login session was removed; backup saved under $backup_dir"
    else
      echo "No saved QQNT login session was found; service restarted"
    fi
    echo "Scan the new account QR code:"
    wait_for_qr_url | "$qrencode_command" -t ANSIUTF8
    ;;
  update)
    installer=${QQNT_BRIDGE_INSTALLER:-/usr/local/libexec/qqnt-bridge/install.sh}
    if [ ! -x "$installer" ]; then
      echo "update installer is missing: $installer" >&2
      echo "run the one-line installer again to repair this installation" >&2
      exit 1
    fi
    temporary_installer=$(mktemp "${TMPDIR:-/tmp}/qqnt-bridge-installer.XXXXXX")
    trap 'rm -f -- "$temporary_installer"' EXIT HUP INT TERM
    cp "$installer" "$temporary_installer"
    chmod 0700 "$temporary_installer"
    case "${2:-}" in
      '') "$temporary_installer" ;;
      release|debug) env QQNT_BRIDGE_MODE="$2" "$temporary_installer" ;;
      *) echo "usage: qqntctl update [release|debug]" >&2; exit 2 ;;
    esac
    rm -f -- "$temporary_installer"
    trap - EXIT HUP INT TERM
    ;;
  *)
    echo "usage: qqntctl {status|qr [--png FILE]|refresh|logs|restart|logout|switch-account|update [release|debug]}" >&2
    exit 2
    ;;
esac
