[Unit]
Description=Headless QQNT with qqnt-bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qqnt-bridge
Group=qqnt-bridge
Environment=HOME=/var/lib/qqnt-bridge
Environment=NO_COLOR=1
EnvironmentFile=/etc/qqnt-bridge.env
WorkingDirectory=/var/lib/qqnt-bridge
ExecStart=/usr/local/libexec/qqnt-bridge/run-headless.sh
Restart=always
RestartSec=3
RuntimeMaxSec=7d
MemoryMax=800M
TimeoutStopSec=20
KillMode=mixed
LimitNOFILE=65536
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/qqnt-bridge

[Install]
WantedBy=multi-user.target
