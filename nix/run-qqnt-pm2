#!/bin/sh
set -eu

repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
nix_bin=/root/.nix-profile/bin/nix

usage() {
  cat <<'EOF'
Usage: nix/run-qqnt-pm2 DATA_DIR DISPLAY VNC_PORT NOVNC_PORT

Runs .#qqnt for PM2 to supervise. All launcher values are passed as separate
arguments; no shell evaluation is used. Set the PM2 process name outside this helper.
EOF
}

require_port() {
  case "$1" in
    ""|*[!0-9]*|0|[1-9][0-9][0-9][0-9][0-9]*)
      printf '%s\n' "invalid port: $1" >&2
      exit 2
      ;;
  esac
}

case "${1:-}" in
  --help|-h)
    usage
    exit 0
    ;;
esac

[ "$#" -eq 4 ] || { usage >&2; exit 2; }
data_dir=$1
display=$2
vnc_port=$3
novnc_port=$4

[ -x "$nix_bin" ] || { printf '%s\n' "Nix executable not found: $nix_bin" >&2; exit 1; }
case "$data_dir" in
  /*) ;;
  *) printf '%s\n' 'DATA_DIR must be an absolute path' >&2; exit 2 ;;
esac
require_port "$vnc_port"
require_port "$novnc_port"

mkdir -p "$data_dir"
exec "$nix_bin" run --offline "$repo#qqnt" -- \
  --data-dir "$data_dir" \
  --display "$display" \
  --vnc-port "$vnc_port" \
  --novnc-port "$novnc_port"
